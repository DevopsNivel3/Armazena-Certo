{
  "expo": {
    "name": "Armazena Certo Contagem",
    "slug": "armazena-certo-contagem",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.armazenacerto.contagem",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para ler códigos de barras durante a contagem de estoque."
      }
    },
    "android": {
      "package": "br.com.armazenacerto.contagem",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#07111f"
      },
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Armazena Certo leia códigos de barras.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permita que o Armazena Certo acesse sua sessão."
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "ee533d1d-3bad-40a2-9825-d3aef7fcaaf6"
      }
    },
    "owner": "jefersonabreu22"
  }
}
